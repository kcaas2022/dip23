I=imread('dipbrain.jpg');
if size(I,3)==3, I=rgb2gray(I); end
BW=imbinarize(I);
D=bwdist(~BW);
W=watershed(-D);
R=BW & (W~=0);
subplot(2,2,1);imshow(I);title('Original');
subplot(2,2,2);imshow(BW);title('Binary');
subplot(2,2,3);imshow(label2rgb(W));title('Watershed');
subplot(2,2,4);imshow(R);title('Segmented');
