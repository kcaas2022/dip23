I = imread('vijay.jpg');

% Add salt-and-pepper noise
N = imnoise(I, 'salt & pepper', 0.05);

% Apply median filtering
if size(N,3) == 3
    F = zeros(size(N), 'like', N);
    for k = 1:3
        F(:,:,k) = medfilt2(N(:,:,k), [3 3]);
    end
else
    F = medfilt2(N, [3 3]);
end

% Display the results
subplot(1,3,1);
imshow(I);
title('Original Color Image');

subplot(1,3,2);
imshow(N);
title('Salt & Pepper Noisy Image');

subplot(1,3,3);
imshow(F);
title('Median Filtered Image');
